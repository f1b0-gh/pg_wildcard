+#[cfg(test)]
+mod prepared_tests {
+    use super::*;
+    use std::sync::Arc;
+
+    #[test]
+    fn prepared_columns_preserve_values_errors_and_bounds() {
+        let arrays: Vec<ArrayRef> = vec![
+            Arc::new(Int64Array::from(vec![Some(i64::MIN), None, Some(i64::MAX)])),
+            Arc::new(UInt64Array::from(vec![Some(u64::MAX), None, Some(0)])),
+            Arc::new(StringArray::from(vec![Some("évidence"), None, Some("\0")])),
+            Arc::new(BinaryArray::from(vec![
+                Some(b"\xff".as_slice()),
+                None,
+                Some(b"".as_slice()),
+            ])),
+            Arc::new(LargeStringArray::from(vec!["", "a", "b"])),
+            Arc::new(NullArray::new(3)),
+            Arc::new(Date32Array::from(vec![0, i32::MAX, i32::MIN])),
+            Arc::new(TimestampNanosecondArray::from(vec![0, 1, i64::MAX])),
+            Arc::new(BooleanArray::from(vec![true, false, true])),
+            Arc::new(Float64Array::from(vec![
+                0.,
+                f64::INFINITY,
+                f64::NEG_INFINITY,
+            ])),
+        ];
+        for array in arrays {
+            for target in [
+                Target::Text,
+                Target::Bytes,
+                Target::Bool,
+                Target::Int16,
+                Target::Int32,
+                Target::Int64,
+                Target::Float32,
+                Target::Float64,
+                Target::Date,
+                Target::Timestamp,
+                Target::TimestampTz,
+            ] {
+                if !supported(array.data_type(), target) {
+                    assert!(PreparedColumn::new(array.clone(), target).is_err());
+                    continue;
+                }
+                let prepared = PreparedColumn::new(array.clone(), target).unwrap();
+                for row in 0..=array.len() {
+                    assert_eq!(
+                        prepared.input(row),
+                        input(array.as_ref(), row, target),
+                        "{target:?} {row}"
+                    );
+                }
+            }
+        }
+    }
+    #[test]
+    fn prepared_column_owns_shared_storage_and_keeps_field_limit() {
+        let prepared = {
+            let array: ArrayRef = Arc::new(StringArray::from(vec!["évidence"]));
+            PreparedColumn::new(array, Target::Text).unwrap()
+        };
+        assert_eq!(prepared.input(0), Ok(Some(Value::Text("évidence"))));
+        let large = "x".repeat(1024 * 1024 + 1);
+        for array in [
+            Arc::new(StringArray::from(vec![large.as_str()])) as ArrayRef,
+            Arc::new(BinaryArray::from(vec![large.as_bytes()])) as ArrayRef,
+        ] {
+            assert_eq!(
+                PreparedColumn::new(array, Target::Text).unwrap().input(0),
+                Err("FDW field exceeds 1 MiB limit")
+            );
+        }
+    }
+}
