+/// Batch-scoped typed views. These clone Arrow buffer references, never values.
+/// The owner must retain the BudgetedBatch lease until these views are dropped.
+pub enum PreparedColumn {
+    Int64(Int64Array),
+    TextBinary(BinaryArray),
+    TextUtf8(StringArray),
+    Fallback(ArrayRef, Target),
+}
+impl PreparedColumn {
+    pub fn new(array: ArrayRef, target: Target) -> Result<Self, &'static str> {
+        if !supported(array.data_type(), target) {
+            return Err("unsupported Arrow/PostgreSQL type pairing");
+        }
+        Ok(match (array.data_type(), target) {
+            (DataType::Int64, Target::Int64) => {
+                Self::Int64(down::<Int64Array>(array.as_ref())?.clone())
+            }
+            (DataType::Binary, Target::Text) => {
+                Self::TextBinary(down::<BinaryArray>(array.as_ref())?.clone())
+            }
+            (DataType::Utf8, Target::Text) => {
+                Self::TextUtf8(down::<StringArray>(array.as_ref())?.clone())
+            }
+            _ => Self::Fallback(array, target),
+        })
+    }
+    pub fn input(&self, row: usize) -> Result<Option<Value<'_>>, &'static str> {
+        // Fall back without duplicating temporal, narrow integer or other type
+        // conversion semantics. Hot types have already been checked once.
+        let a: &dyn Array = match self {
+            Self::Int64(a) => a,
+            Self::TextBinary(a) => a,
+            Self::TextUtf8(a) => a,
+            Self::Fallback(a, target) => return input(a.as_ref(), row, *target),
+        };
+        if row >= a.len() {
+            return Err("Arrow row is out of bounds");
+        }
+        if a.is_null(row) {
+            return Ok(None);
+        }
+        let value = match self {
+            Self::Int64(a) => Value::Int64(a.value(row)),
+            Self::TextBinary(a) => {
+                let bytes = a.value(row);
+                if bytes.len() > 1024 * 1024 {
+                    return Err("FDW field exceeds 1 MiB limit");
+                }
+                if bytes.contains(&0) {
+                    return Err("NUL bytes cannot be represented as PostgreSQL text; use bytea");
+                }
+                Value::Text(std::str::from_utf8(bytes).map_err(
+                    |_| "invalid UTF-8 cannot be represented as PostgreSQL text; use bytea",
+                )?)
+            }
+            Self::TextUtf8(a) => {
+                let text = a.value(row);
+                if text.len() > 1024 * 1024 {
+                    return Err("FDW field exceeds 1 MiB limit");
+                }
+                if text.as_bytes().contains(&0) {
+                    return Err("NUL bytes cannot be represented as PostgreSQL text; use bytea");
+                }
+                Value::Text(text)
+            }
+            Self::Fallback(..) => unreachable!("fallback returned above"),
+        };
+        Ok(Some(value))
+    }
+}
